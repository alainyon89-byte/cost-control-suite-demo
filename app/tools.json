  "tools": [
    {
      "id": "theo_cos",
      "name": "Theoretical CoS Generator",
      "group": "beverage_cellar",
      "version": "v5",
      "what": "Prices the Micros Sales Mix against MM60 and the item map to give the theoretical beverage cost of sales.",
      "inputs_line": "Micros Sales Mix (Report sheet) + MM60 for its plant (from SAP data)",
      "script": "Bev_Theoretical_CoS_Generator.py",
      "needs_console": true,
      "inputs": [
        {
          "key": "file",
          "label": "Micros Sales Mix workbook",
          "accept": [
            ".xlsx"
          ],
          "multiple": false,
          "required": true,
          "detect": [
            {
              "label": "Micros Sales Mix",
              "kind": "micros_sales_mix"
            }
          ]
        },
        {
          "key": "mm60",
          "label": "MM60 price list",
          "shared": "mm60",
          "required": false,
          "deliver": {
            "mode": "embedded_sheet",
            "into": "file",
            "sheet": "MM60"
          },
          "plant_from": "file:file"
        }
      ],
      "options": [],
      "args": [
        "{in:file}"
      ],
      "preflight": [
        {
          "text": "beverage_item_map.xlsx is closed in Excel (new items get added to it)",
          "check": "not_locked:beverage_item_map.xlsx"
        },
        {
          "text": "beverage_item_map.xlsx is in the tool folder",
          "check": "exists:beverage_item_map.xlsx"
        },
        {
          "text": "Cocktail_Costing.xlsx is in the tool folder (cocktails are costed from its recipe sheets)",
          "check": "warn_missing:Cocktail_Costing.xlsx"
        },
        {
          "text": "Pour sizes and VAT are right on the map's House Rules sheet",
          "check": "manual"
        }
      ],
      "prompts": [
        {
          "id": "new_item",
          "match": "Which SAP item or recipe\\?\\s*$",
          "kind": "choice",
          "title_regex": "^\\[\\d+/\\d+\\]\\s+(.*)$",
          "title_prefix": "New POS item: ",
          "options_regex": "\\[([A-Z]?\\d*)\\]\\s+(.+?)(?=\\s{2,}\\[|$)",
          "help": "Pick the SAP item or recipe this POS item is sold from. S skips this one, Q skips the rest."
        },
        {
          "id": "serving",
          "match": "How is it sold\\?\\s*$",
          "kind": "choice",
          "title": "How is it sold?",
          "options_regex": "\\[([A-Z]?\\d*)\\]\\s+(.+?)(?=\\s{2,}\\[|$)",
          "block": "since_prompt"
        },
        {
          "id": "number",
          "match": "(Pour size in ml|Divide the cost by|Cost per bottle / unit R|Bottle / unit size in ml.*|Pack size in ml.*|Recipe cost per drink R):\\s*$",
          "kind": "text",
          "title_from_prompt": true,
          "help": "Type a number above 0."
        },
        {
          "id": "material",
          "match": "SAP material number:\\s*$",
          "kind": "text",
          "title": "SAP material number",
          "help": "Type the SAP material number exactly as it is in MM60."
        }
      ],
      "exit_codes": {
        "0": "finished",
        "1": "failed"
      },
      "outputs": [
        {
          "glob": "*_CoS_Summary.xlsx",
          "where": "next_to_input"
        }
      ],
      "progress": [
        {
          "label": "New items",
          "regex": "POS item\\(s\\) are not in the item map"
        },
        {
          "label": "Report written",
          "regex": "^\\s*Report: "
        }
      ],
      "summary_from_log": [
        {
          "label": "Lines sold",
          "regex": "Lines sold: (\\d+)"
        },
        {
          "label": "In theoretical",
          "regex": "in theoretical: (\\d+)"
        },
        {
          "label": "To review / flagged",
          "regex": "to review/flagged: (\\d+)"
        }
      ],
      "review_links_from_log": [
        "to review/flagged",
        "Item map updated",
        "cocktail costing workbook not found"
      ],
      "data_files": [
        "beverage_item_map.xlsx",
        "Cocktail_Costing.xlsx"
      ],
      "open_files": [
        {
          "label": "Open the item map",
          "file": "beverage_item_map.xlsx"
        }
      ],
      "help": "Open the report and check the Review sheet first. New POS items are asked about one by one and saved to the item map (a dated backup is made first).",
      "atomic": true,
      "ignore_in_regression": [
        {
          "mask": "run \\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d",
          "why": "run date and time in Summary!A4"
        },
        {
          "mask": "Added \\d{4}-\\d\\d-\\d\\d by generator",
          "why": "date a new item was added to the map"
        }
      ]
    },
    {
      "id": "cellar_consumption",
      "name": "Cellar Consumption",
      "group": "beverage_cellar",
      "version": "v2.2",
      "what": "Writes Micros qty sold into Charged on Doc on the cellar sheets.",
      "inputs_line": "Cellar workbook + Micros report(s), .xlsx or .pdf",
      "script": "update_cellar_consumption.py",
      "needs_console": true,
      "inputs": [
        {
          "key": "files",
          "label": "Cellar workbook and Micros report(s)",
          "accept": [
            ".xlsx",
            ".pdf"
          ],
          "multiple": true,
          "required": true,
          "detect": [
            {
              "label": "Cellar Consumption workbook",
              "kind": "cellar_workbook"
            },
            {
              "label": "Micros report",
              "kind": "micros_report"
            }
          ]
        }
      ],
      "options": [
        {
          "key": "sheets",
          "type": "text",
          "label": "Sheet name(s)",
          "help": "Leave blank to pick the sheet from the report's Business Date. Only type names for Bar sheets, e.g. Bar 1,Bar 2",
          "default": ""
        },
        {
          "key": "no_prompt",
          "type": "checkbox",
          "label": "Don't ask me about new items",
          "help": "Strong matches only",
          "arg": "--no-prompt"
        }
      ],
      "args": [
        "--files",
        "{in:files}",
        {
          "when": "opt:sheets",
          "args": [
            "--sheets",
            "{opt:sheets}"
          ]
        },
        "{flags}"
      ],
      "preflight": [
        {
          "text": "cellar_item_map.xlsx is closed in Excel",
          "check": "not_locked:cellar_item_map.xlsx"
        }
      ],
      "prompts": [
        {
          "id": "sheet",
          "match": "Sheet number\\(s\\) or name\\(s\\), comma-separated:\\s*$",
          "kind": "choice",
          "title": "Which sheet should be updated?",
          "options_regex": "^\\s*(\\d+)\\)\\s+(.+)$",
          "help": "Pick a sheet, or type several numbers or names separated by commas."
        },
        {
          "id": "new_item",
          "match": "Your choice:\\s*$",
          "kind": "choice",
          "title_regex": "New Micros item: (.*)$",
          "title_prefix": "New Micros item: ",
          "options_regex": "^\\s*(\\d+)\\)\\s+(.+)$",
          "extra_options": [
            {
              "value": "",
              "label": "Enter: option 1 on a clear match, otherwise skip"
            },
            {
              "value": "S",
              "label": "Skip this time"
            },
            {
              "value": "I",
              "label": "Ignore always (not a stock item)"
            }
          ],
          "help": "Pick the SAP item, or type a SAP code. Your answer is saved to cellar_item_map.xlsx and not asked again."
        }
      ],
      "exit_codes": {
        "0": "finished",
        "1": "failed"
      },
      "outputs": [
        {
          "glob": "*_UPDATED*.xlsx",
          "where": "next_to_input"
        },
        {
          "glob": "*_UPDATE_LOG*.txt",
          "where": "next_to_input"
        }
      ],
      "progress": [
        {
          "label": "Reading Micros",
          "regex": "^Reading Micros report"
        },
        {
          "label": "Writing sheet",
          "regex": "^=== Sheet"
        },
        {
          "label": "Saved",
          "regex": "^Saved: "
        }
      ],
      "summary_from_log": [
        {
          "label": "Micros beverage sales",
          "regex": "Micros beverage sales (R[\\d,\\.]+)"
        },
        {
          "label": "Written to sheet",
          "regex": "written to sheet (R[\\d,\\.]+)"
        },
        {
          "label": "Difference",
          "regex": "difference (R[\\d,\\.-]+\\s+\\[[^\\]]+\\])"
        }
      ],
      "review_links_from_log": [
        "CHECK --",
        "CoS outside",
        "R0 price",
        "used but not sold",
        "sold but not counted",
        "Not written"
      ],
      "data_files": [
        "cellar_item_map.xlsx"
      ],
      "open_files": [
        {
          "label": "Open the item map",
          "file": "cellar_item_map.xlsx"
        }
      ],
      "help": "The original workbook is never changed. The result is saved as <workbook>_UPDATED.xlsx with a log next to it.",
      "atomic": true,
      "ignore_in_regression": []
    },
    {
      "id": "recount_selection",
      "name": "Recount Selection Builder",
      "group": "beverage_cellar",
      "version": "v3",
      "what": "Picks the stock lines that sales and cocktails cannot explain, for recounting.",
      "inputs_line": "L123 variance report + Micros Sales Mix + Cocktail Tracker",
      "script": "select_recount_items.py",
      "flow": "recount_selection",
      "inputs": [
        {
          "key": "files",
          "label": "Variance report, Sales Mix and Cocktail Tracker (any order)",
          "accept": [
            ".xlsx"
          ],
          "multiple": true,
          "required": true,
          "detect": [
            {
              "label": "L123 variance report",
              "kind": "variance_report"
            },
            {
              "label": "Micros Sales Mix",
              "kind": "micros_sales_mix"
            },
            {
              "label": "Cocktail Tracker",
              "kind": "cocktail_tracker"
            },
            {
              "label": "Completed Sales Item Review",
              "kind": "sales_item_review"
            }
          ]
        }
      ],
      "options": [
        {
          "key": "mode",
          "type": "choice",
          "label": "What do you want to do?",
          "default": "build",
          "choices": [
            {
              "value": "build",
              "label": "Build the recount selection"
            },
            {
              "value": "review",
              "label": "Export a Sales Item Review sheet (match Micros items to SAP materials)"
            }
          ]
        }
      ],
      "args": [
        "{in:files}"
      ],
      "preflight": [
        {
          "text": "Stock count captured and the L123 variance report exported to .xlsx",
          "check": "manual"
        },
        {
          "text": "Micros Sales Mix exported for the same period",
          "check": "manual"
        },
        {
          "text": "item_aliases.csv is closed in Excel",
          "check": "not_locked:item_aliases.csv"
        }
      ],
      "exit_codes": {
        "0": "finished",
        "1": "failed",
        "2": "approval_gate"
      },
      "outputs": [
        {
          "glob": "Recount_Selection_*.xlsx",
          "where": "next_to_input"
        },
        {
          "glob": "Sales_Item_Review_*.xlsx",
          "where": "next_to_input"
        }
      ],
      "progress": [
        {
          "label": "Preview",
          "regex": "PROPOSED RECOUNT"
        },
        {
          "label": "Approval",
          "regex": "APPROVAL REQUIRED"
        },
        {
          "label": "Sheet written",
          "regex": "Recount selection sheet written|Written to:"
        }
      ],
      "summary_from_log": [
        {
          "label": "Lines with variance",
          "regex": "Lines w/ variance\\s*:\\s*(\\d+)"
        },
        {
          "label": "Explained by sales",
          "regex": "Explained by sales:\\s*(\\d+)"
        },
        {
          "label": "Unexplained",
          "regex": "Unexplained\\s*:\\s*(\\d+\\s+R [\\d,\\.]+)"
        },
        {
          "label": "Approved by",
          "regex": "Approved by: (.+)$"
        }
      ],
      "review_links_from_log": [
        "APPROVAL REQUIRED",
        "NOTE:",
        "Sold, no variance",
        "need a decision"
      ],
      "data_files": [
        "recount_config.csv",
        "item_overrides.csv",
        "item_aliases.csv"
      ],
      "open_files": [
        {
          "label": "Open item aliases",
          "file": "item_aliases.csv"
        },
        {
          "label": "Open conversions (recount_config.csv)",
          "file": "recount_config.csv"
        }
      ],
      "help": "Drop the three files together; order does not matter. A filled-in Sales Item Review sheet can be dropped with them and is picked up by its contents. More than 20 unexplained lines needs an approver's name before anything is written.",
      "atomic": true,
      "ignore_in_regression": [
        {
          "mask": "\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d",
          "why": "generated date and time"
        }
      ]
    },

    {
      "id": "cost_comparator",
      "name": "MM60 Cost Comparator",
      "group": "reporting",
      "version": "v1.0",
      "what": "Compares unit prices between an older MM60 and a newer one, by category and by item.",
      "inputs_line": "Previous MM60 + current MM60 (from SAP data)",
      "script": "mm60_comparator.py",
      "inputs": [
        {
          "key": "old",
          "label": "Older MM60",
          "shared": "mm60_previous",
          "required": true,
          "deliver": {
            "mode": "pass_as_file"
          },
          "plant_from": "opt:plant"
        },
        {
          "key": "new",
          "label": "Newer MM60",
          "shared": "mm60",
          "required": true,
          "deliver": {
            "mode": "pass_as_file"
          },
          "plant_from": "opt:plant"
        }
      ],
      "options": [
        {
          "key": "plant",
          "type": "choice",
          "label": "Which MM60?",
          "default": "D100",
          "choices": [
            {
              "value": "D100",
              "label": "Hotel (D100)"
            },
            {
              "value": "D200",
              "label": "Conference Centre (D200)"
            }
          ]
        },
        {
          "key": "label_old",
          "type": "text",
          "label": "Label for the older file",
          "help": "e.g. September 2026",
          "required": true,
          "default": ""
        },
        {
          "key": "label_new",
          "type": "text",
          "label": "Label for the newer file",
          "help": "e.g. October 2026",
          "required": true,
          "default": ""
        }
      ],
      "args": [],
      "auto_answers": [
        {
          "match": "Enter FIRST MM60 file",
          "answer": "{in:old}"
        },
        {
          "match": "Enter SECOND MM60 file",
          "answer": "{in:new}"
        },
        {
          "match": "Enter label for first file",
          "answer": "{opt:label_old}"
        },
        {
          "match": "Enter label for second file",
          "answer": "{opt:label_new}"
        },
        {
          "match": "Press Enter to close",
          "answer": ""
        }
      ],
      "preflight": [],
      "exit_codes": {
        "0": "finished",
        "1": "failed"
      },
      "outputs": [
        {
          "glob": "MM60_Comparative_*.xlsx",
          "where": "tool_folder"
        }
      ],
      "progress": [
        {
          "label": "Loading",
          "regex": "^\\s*Loading "
        },
        {
          "label": "Building",
          "regex": "Building summary"
        },
        {
          "label": "Saved",
          "regex": "Output saved"
        }
      ],
      "summary_from_log": [
        {
          "label": "Item rows written",
          "regex": "Summary complete . ([\\d,]+) item rows"
        },
        {
          "label": "Category links",
          "regex": "(\\d+) hyperlinks added"
        }
      ],
      "review_links_from_log": [
        "ERROR"
      ],
      "data_files": [],
      "help": "The older file comes from the SAP data history and the newer one is the current MM60 for the plant you pick. Use the link on a file to pick a different one for this run.",
      "atomic": true,
      "ignore_in_regression": [
        {
          "mask": "Generated: \\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d",
          "why": "generated date and time on the Attribution sheet"
        }
      ]
    },
    {
      "id": "stock_age",
      "name": "Stock Age Dashboard",
      "group": "reporting",
      "version": "",
      "what": "Builds the stock age analysis dashboard from stock on hand and purchase history.",
      "inputs_line": "SAP source workbook (Stock on hand + purchases)",
      "script": "build_age_analysis.py",
      "inputs": [
        {
          "key": "file",
          "label": "Source workbook (Stock on hand / Past year purchase / Past 5 year purchase)",
          "accept": [
            ".xlsx"
          ],
          "multiple": false,
          "required": true,
